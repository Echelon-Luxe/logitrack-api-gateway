# Copy to .env and fill in. .env is gitignored.

# Where to fetch the token-verification public key. Only the public half.
JWKS_URL="http://localhost:3001/.well-known/jwks.json"

# Backend addresses. In Kubernetes these come from the ConfigMap and resolve
# via cluster DNS, so the same image runs in every environment.
USER_SERVICE_URL="http://localhost:3001"
SHIPMENT_SERVICE_URL="http://localhost:3002"
DRIVER_SERVICE_URL="http://localhost:3003"
TRACKING_SERVICE_URL="http://localhost:3004"
NOTIFICATION_SERVICE_URL="http://localhost:3005"
PAYMENT_SERVICE_URL="http://localhost:3006"

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"

PORT=8080
LOG_LEVEL=debug
